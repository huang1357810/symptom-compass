{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mingbian-kangtu",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_KEY": "mbkt-admin-2026"
  },
  "kv_namespaces": [
    { "binding": "FEEDBACK_KV", "id": "1de22f39cfe24e09979c5bc44ad3c288" }
  ]
}
